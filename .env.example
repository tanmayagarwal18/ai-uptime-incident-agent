# Copy this file to .env and fill in your values. Never commit .env.

# --- AI model -----------------------------------------------------------------
# gemini = free Google Gemini (recommended). Key: https://aistudio.google.com/apikey
# groq   = free gpt-oss-120b on Groq. Key: https://console.groq.com/keys
# openai = paid GPT-4.1 mini on OpenAI (needs OPENAI_API_KEY with credit)
# openai_compatible = any OpenAI-style server via OPENAI_BASE_URL (Ollama ...)
# auto   = first of OpenAI, Gemini, Groq that has a key, else the offline demo AI
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used automatically when the main model is busy ("high demand"):
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Only for LLM_PROVIDER=openai / openai_compatible:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# If the AI service fails (free limit reached, bad key, no internet), finish the incident
# with the offline demo AI so the demo never breaks.
LLM_FALLBACK_TO_MOCK=true

# --- GitHub -------------------------------------------------------------------
# Fine-grained token with Repository permissions -> Issues: Read and write (incident tickets)
GITHUB_TOKEN=
GITHUB_REPO=your-username/ai-uptime-incident-agent
GITHUB_DRY_RUN=false

# --- Agent behaviour ----------------------------------------------------------
REQUIRE_HUMAN_APPROVAL=true
AGENT_MAX_ITERATIONS=6
AUTO_VERIFY_RECOVERY=true

# --- Monitoring ---------------------------------------------------------------
CHECK_INTERVAL_SECONDS=30
SITES_CONFIG=config/sites.yaml
DEMO_SERVER_URL=http://127.0.0.1:8001

# --- Storage ------------------------------------------------------------------
DB_PATH=data/monitor.db
CHECKPOINT_DB_PATH=data/checkpoints.db

LOG_LEVEL=INFO
