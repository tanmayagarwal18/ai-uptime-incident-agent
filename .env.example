# Copy this file to .env and fill in your values. Never commit .env.

# --- AI model -----------------------------------------------------------------
# github_models = free GPT-4.1 mini through GitHub Models (recommended)
# openai        = OpenAI's paid API (needs OPENAI_API_KEY)
# openai_compatible = any OpenAI-style server via OPENAI_BASE_URL (Groq, Ollama, Gemini ...)
# auto          = OpenAI if OPENAI_API_KEY is set, else GitHub Models if GITHUB_MODELS_TOKEN is set,
#                 else the offline demo AI
LLM_PROVIDER=github_models
OPENAI_MODEL=gpt-4.1-mini

# For github_models the GitHub token below is used (it needs the "Models: read" permission).
# Optionally use a separate token just for the AI:
GITHUB_MODELS_TOKEN=

# Only for LLM_PROVIDER=openai / openai_compatible:
OPENAI_API_KEY=
OPENAI_BASE_URL=

# If the AI service fails (free limit reached, bad token, no internet), finish the incident
# with the offline demo AI so the demo never breaks.
LLM_FALLBACK_TO_MOCK=true

# --- GitHub -------------------------------------------------------------------
# One fine-grained token can do both jobs:
#   Account permissions  -> Models: Read-only          (free GPT-4.1 mini)
#   Repository permissions -> Issues: Read and write   (incident tickets)
GITHUB_TOKEN=
GITHUB_REPO=your-username/ai-uptime-incident-agent
GITHUB_DRY_RUN=false

# --- Agent behaviour ----------------------------------------------------------
REQUIRE_HUMAN_APPROVAL=true
AGENT_MAX_ITERATIONS=6
AUTO_VERIFY_RECOVERY=true

# --- Monitoring ---------------------------------------------------------------
CHECK_INTERVAL_SECONDS=30
SITES_CONFIG=config/sites.yaml
DEMO_SERVER_URL=http://127.0.0.1:8001

# --- Storage ------------------------------------------------------------------
DB_PATH=data/monitor.db
CHECKPOINT_DB_PATH=data/checkpoints.db

LOG_LEVEL=INFO
