# Copy this file to .env and fill in your values. Never commit .env.

# --- OpenAI (leave empty to run the agent in offline mock mode) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- GitHub (leave GITHUB_TOKEN empty, or set GITHUB_DRY_RUN=true, to skip real issue creation) ---
GITHUB_TOKEN=
GITHUB_REPO=your-username/ai-uptime-incident-agent
GITHUB_DRY_RUN=false

# --- Agent behaviour ---
REQUIRE_HUMAN_APPROVAL=true
AGENT_MAX_ITERATIONS=6
AUTO_VERIFY_RECOVERY=true

# --- Monitoring ---
CHECK_INTERVAL_SECONDS=30
SITES_CONFIG=config/sites.yaml
DEMO_SERVER_URL=http://127.0.0.1:8001

# --- Storage ---
DB_PATH=data/monitor.db
CHECKPOINT_DB_PATH=data/checkpoints.db

LOG_LEVEL=INFO
